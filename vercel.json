{
  "version": 2,
  "builds": [
    {
      "src": "api/ai.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/boardroom.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["PIANO-90-GIORNI.md"] }
    },
    {
      "src": "api/telegram.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["PIANO-90-GIORNI.md"] }
    },
    {
      "src": "api/war.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["CM-WAR-STATO.md"] }
    },
    {
      "src": "api/whatsapp.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/agents.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "boardroom.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/ai",
      "dest": "/api/ai.js"
    },
    {
      "src": "/api/boardroom",
      "dest": "/api/boardroom.js"
    },
    {
      "src": "/api/telegram",
      "dest": "/api/telegram.js"
    },
    {
      "src": "/api/war",
      "dest": "/api/war.js"
    },
    {
      "src": "/api/whatsapp",
      "dest": "/api/whatsapp.js"
    },
    {
      "src": "/api/agents",
      "dest": "/api/agents.js"
    },
    {
      "src": "/boardroom",
      "dest": "/boardroom.html",
      "headers": { "Cache-Control": "no-store, must-revalidate" }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": { "Cache-Control": "no-store, must-revalidate" }
    }
  ],
  "crons": [
    { "path": "/api/agents?run=daily", "schedule": "50 6 * * *" }
  ]
}
