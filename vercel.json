{
  "version": 2,
  "builds": [
    {
      "src": "api/ai.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/boardroom.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "boardroom.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/ai",
      "dest": "/api/ai.js"
    },
    {
      "src": "/api/boardroom",
      "dest": "/api/boardroom.js"
    },
    {
      "src": "/boardroom",
      "dest": "/boardroom.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
