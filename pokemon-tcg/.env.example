# =====================================================================
#  CONFIGURAZIONE CHIAVI - Modulo Pokémon TCG
# ---------------------------------------------------------------------
#  Copia questo file in ".env" (senza .example) e inserisci i tuoi valori.
#  Il file .env NON va mai committato su git (è già nel .gitignore).
# =====================================================================

# Chiave API gratuita di pokemontcg.io (https://dev.pokemontcg.io/).
# OPZIONALE: se la lasci vuota, il sistema funziona comunque ma con
# limiti di richieste più bassi.
POKEMONTCG_API_KEY=

# Chiave API Anthropic (Claude). NON serve allo Step 1.
# La useremo allo Step 2 (generazione contenuti). Puoi già inserirla.
ANTHROPIC_API_KEY=
